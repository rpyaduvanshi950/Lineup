<!-- The "photo" area inside a decorative polaroid card: a muted gradient standing in for an
     unset picture (no real photo exists yet on the VideoSelect screen). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#3A3F4A"
        android:endColor="#23262E" />
    <corners android:radius="2dp"/>
</shape>
