<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:padding="28dp">

    <FrameLayout
        android:id="@+id/heroCircle"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_hero_circle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.22">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_video_hero"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/app_name"
        android:textColor="@color/color_text_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/heroCircle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/home_subtitle"
        android:textColor="@color/color_text_secondary"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/stepsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/subtitleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout style="@style/HomeStepRow">
            <ImageView style="@style/HomeStepIcon" android:src="@drawable/ic_stage_frames" />
            <TextView style="@style/HomeStepText" android:text="@string/home_step_1" />
        </LinearLayout>

        <View style="@style/HomeStepDivider" />

        <LinearLayout style="@style/HomeStepRow">
            <ImageView style="@style/HomeStepIcon" android:src="@drawable/ic_stage_identify" />
            <TextView style="@style/HomeStepText" android:text="@string/home_step_2" />
        </LinearLayout>

        <View style="@style/HomeStepDivider" />

        <LinearLayout style="@style/HomeStepRow">
            <ImageView style="@style/HomeStepIcon" android:src="@drawable/ic_stage_cluster" />
            <TextView style="@style/HomeStepText" android:text="@string/home_step_3" />
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/selectButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:text="@string/select_video"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
