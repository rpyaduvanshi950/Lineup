<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- Percentage guidelines so this holds up across screen sizes, not just one device. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideHeadlineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.30" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideButtonTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.80" />

    <!-- ============ Decorative scattered polaroids: foreshadows the collage output ============ -->
    <FrameLayout
        android:id="@+id/polaroidA"
        android:layout_width="96dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_polaroid"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:alpha="0.55"
        android:rotation="-11"
        app:layout_constraintTop_toTopOf="@id/guideHeadlineTop"
        app:layout_constraintBottom_toTopOf="@id/guideButtonTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias="0.12"
        app:layout_constraintVertical_bias="0.55">
        <View android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/bg_polaroid_photo" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/polaroidB"
        android:layout_width="104dp"
        android:layout_height="130dp"
        android:background="@drawable/bg_polaroid"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:alpha="0.65"
        android:rotation="7"
        app:layout_constraintTop_toTopOf="@id/guideHeadlineTop"
        app:layout_constraintBottom_toTopOf="@id/guideButtonTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.82"
        app:layout_constraintVertical_bias="0.35">
        <View android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/bg_polaroid_photo" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/polaroidC"
        android:layout_width="88dp"
        android:layout_height="110dp"
        android:background="@drawable/bg_polaroid"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:alpha="0.45"
        android:rotation="-4"
        app:layout_constraintTop_toTopOf="@id/guideHeadlineTop"
        app:layout_constraintBottom_toTopOf="@id/guideButtonTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.62"
        app:layout_constraintVertical_bias="0.82">
        <View android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/bg_polaroid_photo" />
    </FrameLayout>

    <!-- ============ Headline + subtitle ============ -->
    <TextView
        android:id="@+id/headlineText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        android:text="@string/home_headline"
        android:textAppearance="@style/TextAppearance.Lineup.Headline"
        android:textSize="34sp"
        app:layout_constraintTop_toTopOf="@id/guideHeadlineTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="40dp"
        android:gravity="center"
        android:text="@string/home_subtitle"
        android:textAppearance="@style/TextAppearance.Lineup.Body"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp"
        app:layout_constraintTop_toBottomOf="@id/headlineText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ============ CTA with a soft glow behind it ============ -->
    <View
        android:id="@+id/buttonGlow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:background="@drawable/bg_button_glow"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintDimensionRatio="2.2:1"
        app:layout_constraintTop_toTopOf="@id/guideButtonTop"
        app:layout_constraintBottom_toBottomOf="@id/selectButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/selectButton"
        style="@style/Widget.Lineup.Button.Amber"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginHorizontal="40dp"
        android:minHeight="48dp"
        android:text="@string/select_video"
        android:textSize="17sp"
        app:icon="@drawable/ic_video_hero"
        app:iconSize="20dp"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:layout_constraintTop_toTopOf="@id/guideButtonTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
