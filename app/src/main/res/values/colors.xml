<resources>
    <!-- Cinematic photo-booth palette: one deliberate dark identity, not a light/dark pair.
         Forced dark theme (Theme.Lineup no longer branches on system day/night); see themes.xml. -->
    <color name="color_background">#121212</color>
    <color name="color_surface">#1E1D25</color>
    <color name="color_surface_alt">#28262F</color>
    <color name="color_divider">#332F3A</color>

    <color name="accent_amber">#F2B84B</color>
    <color name="accent_amber_dim">#B98B2E</color>
    <color name="accent_coral">#FF6B5B</color>

    <color name="color_text_primary">#F5F3EF</color>
    <color name="color_text_secondary">#9C98A6</color>
    <!-- Text/icon color used ON amber-filled surfaces (buttons, badges): near-black for
         WCAG-AA contrast against the light amber background; white would fail there. -->
    <color name="color_on_amber">#1A1508</color>

    <!-- Person avatar-chip palette (cycled by index): warm, cinematic, distinguishable in
         low light against the dark canvas. -->
    <color name="avatar_1">#F2B84B</color>
    <color name="avatar_2">#FF6B5B</color>
    <color name="avatar_3">#7EC8A9</color>
    <color name="avatar_4">#8FA6D6</color>
    <color name="avatar_5">#C98FD6</color>
    <color name="avatar_6">#D6B88F</color>

    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
</resources>
