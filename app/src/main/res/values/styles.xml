<resources>

    <!-- ============================== Typography ============================== -->
    <!-- Manrope ExtraBold for hero content (big display numerals, headlines):
         "make the numbers feel like the hero content." Body text stays on the system default
         (Roboto/Inter) intentionally, per the design brief. -->
    <style name="TextAppearance.Lineup.Display" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/manrope_extrabold</item>
        <item name="android:fontFamily">@font/manrope_extrabold</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Lineup.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/manrope_extrabold</item>
        <item name="android:fontFamily">@font/manrope_extrabold</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.Lineup.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Lineup.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <!-- ============================== Shapes ============================== -->
    <style name="ShapeAppearance.Lineup.Card" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Lineup.Pill" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ============================== Buttons ============================== -->
    <style name="Widget.Lineup.Button.Amber" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent_amber</item>
        <item name="android:textColor">@color/color_on_amber</item>
        <item name="iconTint">@color/color_on_amber</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Lineup.Pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textStyle">bold</item>
        <item name="elevation">6dp</item>
    </style>

    <style name="Widget.Lineup.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/accent_amber</item>
        <item name="android:textColor">@color/accent_amber</item>
        <item name="iconTint">@color/accent_amber</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Lineup.Pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
